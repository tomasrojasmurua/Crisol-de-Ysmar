{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crisol-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // Registro de errores (ver docs/errores.md). Sin database_id: wrangler la crea al publicar si
  // no existe y la conecta por nombre si ya existe.
  "d1_databases": [{ "binding": "ERRORS", "database_name": "crisol-errores" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
