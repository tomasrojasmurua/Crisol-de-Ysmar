# Cloudflare Pages. La página siempre se pregunta al servidor antes de usar una copia guardada:
# una copia vieja pide archivos de una versión que ya no existe y el juego queda en negro (el
# ícono de inicio del iPhone guardaba la suya). Los archivos de assets/ llevan su huella en el
# nombre: esos sí se guardan para siempre.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
